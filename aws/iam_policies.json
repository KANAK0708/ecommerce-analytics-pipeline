{
  "Version": "2012-10-17",
  "Comment": "Least-privilege IAM policies for Lambda Trigger and AWS Glue PySpark ETL",
  "Roles": {
    "LambdaETLTriggerRole": {
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": { "Service": "lambda.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "Policies": [
        {
          "PolicyName": "LambdaGlueTriggerPolicy",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AllowGlueJobExecution",
                "Effect": "Allow",
                "Action": [
                  "glue:StartJobRun",
                  "glue:GetJobRun",
                  "glue:GetJobRuns"
                ],
                "Resource": "arn:aws:glue:*:*:job/ecommerce-medallion-etl"
              },
              {
                "Sid": "AllowS3BronzeRead",
                "Effect": "Allow",
                "Action": [
                  "s3:GetObject",
                  "s3:ListBucket"
                ],
                "Resource": [
                  "arn:aws:s3:::<YOUR_S3_BUCKET_NAME>/bronze/*",
                  "arn:aws:s3:::<YOUR_S3_BUCKET_NAME>"
                ]
              },
              {
                "Sid": "AllowCloudWatchLogs",
                "Effect": "Allow",
                "Action": [
                  "logs:CreateLogGroup",
                  "logs:CreateLogStream",
                  "logs:PutLogEvents"
                ],
                "Resource": "arn:aws:logs:*:*:*"
              }
            ]
          }
        }
      ]
    },
    "GlueETLExecutionRole": {
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": { "Service": "glue.amazonaws.com" },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "Policies": [
        {
          "PolicyName": "GlueS3AndCatalogAccessPolicy",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [
              {
                "Sid": "AllowS3DataLakeAccess",
                "Effect": "Allow",
                "Action": [
                  "s3:GetObject",
                  "s3:PutObject",
                  "s3:DeleteObject",
                  "s3:ListBucket"
                ],
                "Resource": [
                  "arn:aws:s3:::<YOUR_S3_BUCKET_NAME>",
                  "arn:aws:s3:::<YOUR_S3_BUCKET_NAME>/*"
                ]
              },
              {
                "Sid": "AllowGlueCatalogAccess",
                "Effect": "Allow",
                "Action": [
                  "glue:GetDatabase",
                  "glue:GetTable",
                  "glue:GetPartitions",
                  "glue:CreateTable",
                  "glue:UpdateTable",
                  "glue:BatchCreatePartition"
                ],
                "Resource": "*"
              },
              {
                "Sid": "AllowGlueCloudWatchLogs",
                "Effect": "Allow",
                "Action": [
                  "logs:CreateLogGroup",
                  "logs:CreateLogStream",
                  "logs:PutLogEvents"
                ],
                "Resource": "arn:aws:logs:*:*:*"
              }
            ]
          }
        }
      ]
    }
  }
}
